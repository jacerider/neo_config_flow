<?php

/**
 * @file
 * Install, update and uninstall functions for the Neo Config Flow module.
 */

use Drupal\Core\Config\FileStorage;
use Drupal\Core\Site\Settings;
use Drupal\Component\Render\FormattableMarkup;

/**
 * Implements hook_install().
 *
 * Writes the bundled config split and config ignore settings, which a profile
 * would otherwise load before this module can. Two things are left alone,
 * because either one silently replaces the rules a live site runs on:
 *
 * - Config that already exists. A site moving to this module from another one
 *   (or reinstalling it) keeps the split and the ignore list it has.
 * - Everything, during a config import. The site's own settings are being
 *   imported alongside this module; the bundled ignore list names nothing
 *   real, so a site that took it mid-import would stop ignoring the config it
 *   keeps out of sync — webforms, say — and the next import would delete it.
 */
function neo_config_flow_install($is_syncing = FALSE) {
  if ($is_syncing) {
    return;
  }
  $config_path = \Drupal::service('extension.list.module')->getPath('neo_config_flow') . '/config/optional';
  $source = new FileStorage($config_path);
  $config_storage = \Drupal::service('config.storage');
  $files = $source->listAll('');
  foreach ($files as $name) {
    if ($config_storage->exists($name)) {
      continue;
    }
    $config_storage->write($name, $source->read($name));
  }
}

/**
 * Implements hook_requirements().
 */
function neo_config_flow_requirements($phase) {
  $requirements = [];

  if ($phase == 'runtime') {
    $ready = Settings::get('config_readonly');
    $requirements['neo_config_flow'] = [
      'title' => t('Neo Config Flow'),
      'value' => $ready ? t('Enabled') : t('Not Configured'),
    ];
    $description = '';
    if (!$ready) {
      $requirements['neo_config_flow']['severity'] = REQUIREMENT_ERROR;
      $description .= t('
  Please add the following to your settings.php file: <br><pre>

if (PHP_SAPI !== \'cli\') {
  $settings[\'config_readonly\'] = TRUE;
}</pre>
      ');
    }
    $description .= t('
  <br>When developing, please add the following to your settings.local.php:<br><pre>

$config[\'config_split.config_split.dev\'][\'status\'] = TRUE;</pre>
    ');
    $requirements['neo_config_flow']['description'] = new FormattableMarkup($description, []);
  }

  return $requirements;
}
